# Copy to .env and fill in. Every variable here is read by a dature loader at
# startup, so a bad value fails the process immediately and names itself —
# there is no setting that only breaks on the update that happens to need it.
#
# Variables with a default are commented out. Uncomment only to override.

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# From BotFather. Must look like "<bot_id>:<secret>"; the loader checks the
# shape, which turns the commonest deployment mistake into a startup error
# instead of a 401 from getUpdates.
#
# Read by the bot, the worker and the scheduler, and each refuses to start
# without it: the worker sends order notifications as the same bot, and the
# scheduler builds the worker's broker to agree with it on queue naming. Two
# variables would be two copies of one secret, and the second one is the one
# forgotten on rotation. The catalog receiver and the seeder never read it —
# the receiver checks the token 1C presents, a different variable.
TELEGRAM_BOT_TOKEN=

# Language used before we know the person's own. One of: ru, en
#TELEGRAM_DEFAULT_LOCALE=ru

# Whether a half-finished dialogue survives a restart. Memory storage is for
# running the bot with nothing but a token; in production a deploy would drop
# everyone mid-order.
#TELEGRAM_USE_REDIS_STORAGE=true

# Stops one chat's updates being handled twice at once. Memory isolation covers
# a single process only, so with more than one replica this must stay on.
#TELEGRAM_USE_REDIS_EVENT_ISOLATION=true

# Each request gets its own locale context rather than sharing one a concurrent
# update could change.
#TELEGRAM_USE_I18N_ISOLATION=true

# Discard updates that queued up while the bot was down. An order placed twenty
# minutes ago and answered now is worse than one quietly lost.
#TELEGRAM_DROP_PENDING_UPDATES=true

# How long an abandoned dialogue — a half-typed address, a deep link waiting
# for a registration — stays in Redis, in seconds. Seven days by default.
#TELEGRAM_FSM_TTL_SECONDS=604800

# Where the Bot API traffic leaves through, if not directly. Unset or empty
# means the process talks to api.telegram.org itself, which is right wherever
# Telegram is reachable. Set a proxy URL — socks5://, socks4:// or http://,
# with a host and a port, credentials inside if the proxy wants any — when the
# data centre's own route to Telegram cannot be relied on.
#
# Read by the bot and by the worker, and both must see the same value: the
# worker sends notifications to the same api.telegram.org from the same
# machine, so a proxy set for one and not the other leaves half the traffic on
# the route that was not trusted. The loader checks the shape at startup;
# https:// and socks5h:// are refused, because the library the session is
# built on does not speak them. The value carries the proxy's password and is
# masked in error output.
#TELEGRAM_PROXY_URL=socks5://user:password@proxy.internal:1080

# ---------------------------------------------------------------------------
# Administrators
# ---------------------------------------------------------------------------
# ADMIN sits above every role, so nobody can grant it through the bot — these
# numbers are the only way the first administrator exists. Applied both at
# startup and at registration, so it does not matter which happened first.
#
# Numbers, not telegram ids: identity here is the phone number, and an admin
# listed by telegram id would stop being one the moment they wrote from MAX.
# Any shape is accepted; they are normalised the way a registration is.
#GOLDY_ADMIN_PHONE_NUMBERS=+79991234567,+79997654321

# ---------------------------------------------------------------------------
# Catalog
# ---------------------------------------------------------------------------
# The price list shown to a customer the catalog holds no binding for. Required:
# the loader refuses to start without it, because an empty value would reach the
# pricing gateway as an identifier matching no row, and the first customer
# without a binding would be told their price list is not configured — a message
# about somebody else's mistake, delivered to the one person who cannot fix it.
#
# 1C has no "main price type" flag to send us, so this choice is ours and lives
# here rather than in the exchange contract. The value is the 1C identifier of
# the price type, and it must be one of the price types the import brought in.
GOLDY_DEFAULT_PRICE_TYPE_ID=

# ---------------------------------------------------------------------------
# Catalog receiver
# ---------------------------------------------------------------------------
# Read by `python -m goldy.catalog_receiver_app` only — the one process 1C
# writes to. The bot, the worker and the scheduler never see these, and the
# token in particular reaches no container but the receiver's.
#
# The bearer token 1C sends in `Authorization`. The same value goes into the
# extension's constant гб_ТокенБота, and rotating it means changing both. At
# least 32 characters after trimming; the loader refuses a shorter one, because
# a token this endpoint is protected by is the only thing between the public
# internet and a full rewrite of the catalog.
GOLDY_CATALOG_RECEIVER_TOKEN=

# Where the receiver listens. Loopback by default, so a receiver started on a
# workstation does not open a catalog-rewriting endpoint to the network. The
# compose file sets 0.0.0.0 for the container itself; on a host that also faces
# the internet, bind to the address the reverse proxy talks to.
#GOLDY_CATALOG_RECEIVER_HOST=127.0.0.1
#GOLDY_CATALOG_RECEIVER_PORT=8090

# Largest request body accepted, in MiB; anything bigger is answered 413 before
# it is read. The extension sends products in batches of a thousand and prices
# in batches of two thousand, which stays well under the default, so a body
# that hits the limit is a broken export rather than a big one.
#GOLDY_CATALOG_RECEIVER_MAX_BODY_MIB=64

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=goldy
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=goldy
POSTGRES_DRIVER=asyncpg

# ---------------------------------------------------------------------------
# SQLAlchemy pool
# ---------------------------------------------------------------------------
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=30
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=5
DB_ECHO=false
#DB_AUTO_FLUSH=false
#DB_EXPIRE_ON_COMMIT=false
#DB_FUTURE=true

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# An empty user falls back to the "default" ACL account, which carries every
# permission — name a scoped user in production. A user without a password is
# refused: it cannot authenticate.
#REDIS_USER=
#REDIS_PASSWORD=

# Four purposes, four databases, and the loader refuses duplicates. They hold
# data with different lifetimes: flushing the cache must not drop everyone
# mid-dialogue, and schedules outlive the tasks they spawn.
#REDIS_WORKER_DB=1
#REDIS_SCHEDULE_SOURCE_DB=2
#REDIS_CACHE_DB=0
#REDIS_FSM_DB=3

# ---------------------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Required, with no default on purpose. RabbitMQ accepts the built-in guest
# account over loopback only, so a deployment that forgot these would fail on
# connect with a bare "access refused" rather than at startup.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# "/" is the default virtual host. It is percent-encoded into the URI, so a
# bare slash here is correct.
#RABBITMQ_VHOST=/

# ---------------------------------------------------------------------------
# taskiq
# ---------------------------------------------------------------------------
# Queue naming. The dead-letter queue must differ from the live one, or a
# poisoned message is redelivered to the workers that already rejected it.
#TASKIQ_EXCHANGE_NAME=goldy
#TASKIQ_QUEUE_NAME=goldy.tasks
#TASKIQ_ROUTING_KEY=goldy.tasks
#TASKIQ_DEAD_LETTER_QUEUE_NAME=goldy.dead_letter

# How many messages one worker prefetches. Low on purpose: a large prefetch
# lets one replica hoard the queue while another sits idle.
#TASKIQ_QOS=10

# Seconds a task result is kept in Redis.
#TASKIQ_RESULT_EX_TIME=1000

# Retry policy. Jitter matters because replicas fail together — a broker blip
# hits every worker at once, and without it they all retry in the same instant
# and reproduce the outage.
#TASKIQ_DEFAULT_RETRY_COUNT=3
#TASKIQ_DEFAULT_DELAY=5.0
#TASKIQ_USE_JITTER=true
#TASKIQ_USE_DELAY_EXPONENT=true
#TASKIQ_MAX_DELAY_EXPONENT=60.0
