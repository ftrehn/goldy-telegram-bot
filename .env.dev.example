# Local development, ready to copy:  cp .env.dev.example .env
#
# Points at docker-compose.dev.yml, whose host ports are offset because 5432 and
# 5433 on this machine belong to PostgreSQL for 1C.
#
#   docker compose -f docker-compose.dev.yml up -d
#   uv run --frozen alembic upgrade head
#
# .env itself is not committed — .gitignore excludes it.

# Token of the DEVELOPMENT bot from BotFather — not the one real customers
# write to. Registration links accounts by phone number, so a test order placed
# through the production bot reaches real people.
#
# The worker and the scheduler need it too, and refuse to start without it:
# notifications go out as the same bot the customer already talks to, and the
# scheduler builds the worker's broker. One variable rather than two copies of
# one secret.
TELEGRAM_BOT_TOKEN=

TELEGRAM_DEFAULT_LOCALE=ru
TELEGRAM_USE_REDIS_STORAGE=true
TELEGRAM_USE_REDIS_EVENT_ISOLATION=true

# Your own number, so the first /start hands you the ADMIN role.
#GOLDY_ADMIN_PHONE_NUMBERS=+79991234567

# The site's retail price list; the example snapshot under docs/design/
# carries it too, so the seeder works without the site.
GOLDY_DEFAULT_PRICE_TYPE_ID=BASE

# The worker and the scheduler pull the catalog from the site and refuse to
# start without these. A local site stand (the tkgoldy repo's docker compose)
# answers on http://localhost:8088; plain http is allowed only for local hosts.
GOLDY_SITE_API_URL=http://localhost:8088/api/v1
GOLDY_SITE_API_TOKEN=
#GOLDY_CATALOG_SYNC_CRON=*/15 * * * *

POSTGRES_USER=goldy
POSTGRES_PASSWORD=goldy
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=goldy
POSTGRES_DRIVER=asyncpg

DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=30
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=5
DB_ECHO=false

REDIS_HOST=localhost
REDIS_PORT=6380

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
