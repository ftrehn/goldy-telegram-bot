	<!-- Внешнее соединение через COM (V83.COMConnector): роль назначается
	     служебному пользователю, от имени которого скрипты ходят в базу.
	     Без этого права Connect() отказывает до какого-либо чтения таблиц.
	     Права на вход клиентом (ThinClient) нарочно нет: константы правит
	     set_constants.ps1 через то же COM-соединение. Само регламентное
	     задание работает в привилегированном режиме и от прав роли не
	     зависит. -->
	<object>
		<name>Configuration.УправлениеТорговлей</name>
		<right>
			<name>ExternalConnection</name>
			<value>true</value>
		</right>
	</object>
