// Обмен с Голди-ботом: выгрузка каталога в приёмник каталога бота по HTTP.
//
// 1С здесь — инициатор: регламентное задание зовёт ВыгрузитьКаталогПоРасписанию,
// модуль сам ходит в бота обычными HTTP-запросами. Никакой очереди и никакой
// публикации базы: бот про 1С знает только по токену в заголовке (ADR-0004
// в репозитории бота).
//
// Один прогон — один batch_id на все области. Области идут в фиксированном
// порядке: категории, товары, виды цен, цены (по каждому виду отдельно),
// остатки, привязки видов цен к телефонам. Каждая область заканчивается
// финализацией — по ней бот подметает в своей проекции всё, чего в этой
// области не было. Отсюда два правила, которые модуль соблюдает строго:
//   1. пачка с нулём строк не отправляется, но пустая область всё равно
//      финализируется — «в 1С ничего не осталось» тоже надо донести;
//   2. любая ошибка — исключение и остановка прогона: область, на которой
//      он упал, остаётся в боте незавершённой, а не подметённой наполовину.
// Особый случай — ноль товаров после отбора: это почти наверняка ошибка в
// сегменте, и деактивировать по ней весь каталог нельзя, поэтому исключение
// поднимается до какой-либо отправки.
//
// Сбор пачек написан один раз и не знает, куда они уходят: «отправитель» —
// структура с полем Режим («HTTP» или «Файлы»). В файловом режиме те же пачки
// и финализации ложатся JSON-файлами в папку — так можно посмотреть, что
// именно уйдёт в бота, без бота и без сети.
//
// Настройки — пять констант расширения: гб_АдресБота, гб_ТокенБота,
// гб_ВидыЦенБота, гб_СкладБота, гб_СегментНоменклатурыБота. Журнал
// регистрации — событие «ГолдиБот.ВыгрузкаКаталога».

#Область ПрограммныйИнтерфейс

// Полный прогон выгрузки каталога в Голди-бот по HTTP.
//
// Возвращаемое значение:
//  Строка - многострочный отчёт: batch_id, назначение, число товаров после
//           отбора, по каждой области — пачек, строк, accepted/discarded/swept
//           из ответов бота, пропущенные строки с упаковкой, конфликты
//           телефонов, длительность.
//
// Исключения: любая ошибка настроек, запроса или HTTP, а также уже идущий
// прогон регламентного задания (см. ОтклонитьПараллельныйПрогон). В тексте
// ошибки HTTP — область, номер пачки, код ответа и первые 500 символов тела.
//
Функция ВыгрузитьКаталог() Экспорт

	Отправитель = НовыйОтправительHTTP(НастройкиСвязи());
	Возврат ВыполнитьПрогон(НастройкиВыборки(), Отправитель);

КонецФункции

// Обёртка для регламентного задания гб_ВыгрузкаКаталогаВБот.
//
// Регламентное задание не показывает результат никому, поэтому и отчёт, и
// ошибка уходят в журнал регистрации. Исключение после записи в журнал
// поднимается заново: так задание считается завершившимся с ошибкой и
// платформа перезапускает его по своим настройкам.
//
Процедура ВыгрузитьКаталогПоРасписанию() Экспорт

	Попытка
		Отчет = ВыгрузитьКаталог();
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;

	ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Информация, , , Отчет);

КонецПроцедуры

// Проверка связи с приёмником: GET /catalog/ping с токеном из констант.
//
// Диагностический вход: ошибки соединения не перехватываются, чтобы
// вызывающая сторона видела текст платформы целиком.
//
// Возвращаемое значение:
//  Строка - «HTTP <код>: <тело ответа>».
//
Функция ПроверитьСвязь() Экспорт

	Связь = НастройкиСвязи();
	Адрес = РазобратьАдрес(Связь.Адрес);
	Соединение = НовоеСоединение(Адрес);

	Запрос = Новый HTTPЗапрос(Адрес.Путь + "/catalog/ping", ЗаголовкиЗапроса(Связь.Токен));
	Ответ = Соединение.Получить(Запрос);

	Возврат "HTTP " + Формат(Ответ.КодСостояния, "ЧН=0; ЧГ=0") + ": " + Ответ.ПолучитьТелоКакСтроку();

КонецФункции

// Тот же прогон, но без отправки: каждая пачка пишется файлом
// <NNN>-<scope>[-<price_type_id|warehouse_id>].json, каждая финализация —
// файлом <NNN>-finalize-<scope>.json, в порядке отправки. Адрес и токен бота
// не читаются: диагностика работает до того, как бот настроен.
//
// Параметры:
//  Каталог - Строка - папка на сервере 1С; создаётся, если её нет.
//
// Возвращаемое значение:
//  Строка - тот же отчёт, что у ВыгрузитьКаталог, без счётчиков бота.
//
Функция ВыгрузитьКаталогВФайлы(Знач Каталог) Экспорт

	Отправитель = НовыйОтправительФайлы(Каталог);
	Возврат ВыполнитьПрогон(НастройкиВыборки(), Отправитель);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПараметрыМодуля

// В общем модуле нет переменных, поэтому константы модуля — функции.

Функция РазмерПачкиТоваров()

	Возврат 1000;

КонецФункции

// Цены и остатки: строка короче товарной, пачка вдвое больше.
Функция РазмерПачкиДвижений()

	Возврат 2000;

КонецФункции

// Ноль — область уходит одной пачкой независимо от числа строк.
Функция БезРазбиенияНаПачки()

	Возврат 0;

КонецФункции

Функция ТаймаутСоединения()

	Возврат 120;

КонецФункции

Функция ИмяСобытияЖурнала()

	Возврат "ГолдиБот.ВыгрузкаКаталога";

КонецФункции

#КонецОбласти

#Область Прогон

// Общий обход для обоих режимов. Прогон — структура-контекст, которую получают
// все процедуры областей: идентификатор, настройки, отправитель, менеджер
// временных таблиц с ВТ_Номенклатура и накопленные строки отчёта.
Функция ВыполнитьПрогон(Настройки, Отправитель)

	// Привилегированным общий модуль расширения быть не может (конфигуратор
	// отказывает при обновлении конфигурации базы), поэтому режим включается
	// здесь. Роль гб_ОбменСБотом при этом остаётся: она нужна для констант и
	// на случай, если прогон когда-нибудь запустят без этого вызова.
	УстановитьПривилегированныйРежим(Истина);
	ОтклонитьПараллельныйПрогон();

	Прогон = Новый Структура;
	Прогон.Вставить("Идентификатор", НовыйИдентификаторПрогона());
	Прогон.Вставить("Настройки", Настройки);
	Прогон.Вставить("Отправитель", Отправитель);
	Прогон.Вставить("МенеджерВТ", Новый МенеджерВременныхТаблиц);
	Прогон.Вставить("Начало", ТекущаяУниверсальнаяДатаВМиллисекундах());
	Прогон.Вставить("Отчет", Новый Массив);

	Прогон.Отчет.Добавить("Выгрузка каталога в Голди-бот");
	Прогон.Отчет.Добавить("batch_id: " + Прогон.Идентификатор);
	Прогон.Отчет.Добавить("Назначение: " + Отправитель.Описание);
	Прогон.Отчет.Добавить("Виды цен: " + ИменаВидовЦен(Настройки));
	Прогон.Отчет.Добавить("Склад: " + Настройки.СкладНаименование);

	КоличествоТоваров = ПодготовитьНоменклатуру(Прогон);
	Прогон.Отчет.Добавить("Товаров после отбора: " + Формат(КоличествоТоваров, "ЧН=0; ЧГ=0")
		+ " (" + ОписаниеОтбора(Настройки) + ")");

	ВыгрузитьКатегории(Прогон);
	ВыгрузитьТовары(Прогон);
	ВыгрузитьВидыЦен(Прогон);
	ВыгрузитьЦены(Прогон);
	ВыгрузитьОстатки(Прогон);
	ВыгрузитьПривязкиВидовЦен(Прогон);

	Затрачено = (ТекущаяУниверсальнаяДатаВМиллисекундах() - Прогон.Начало) / 1000;
	Прогон.Отчет.Добавить("Длительность: " + Формат(Затрачено, "ЧДЦ=1; ЧН=0") + " с");

	Возврат СтрСоединить(Прогон.Отчет, Символы.ПС);

КонецФункции

// Два прогона одновременно портят друг друга: у каждого свой batch_id, а
// финализация подметает всё с чужим batch_id, то есть строки, которые второй
// прогон только что записал. Платформа не даёт регламентному заданию
// запуститься поверх самого себя, но COM-вызов из run_export.ps1 она за
// задание не считает, поэтому проверка здесь: активное фоновое задание с
// методом нашего задания, кроме того, из которого вызван сам прогон. Имя
// метода берётся из метаданных, а не пишется строкой: у фонового задания оно
// ровно такое, каким его хранит платформа, а не таким, как в XML выгрузки.
//
// Обратное направление — задание стартует, пока идёт COM-прогон, — отсюда
// не закрыть: COM-сеанс не фоновое задание, и заданию не по чему его
// заметить. README велит выключать задание перед ручным прогоном.
Процедура ОтклонитьПараллельныйПрогон()

	// Во внешнем соединении (COM) метода ПолучитьТекущее у менеджера фоновых
	// заданий нет — «Метод объекта не обнаружен» (проверено на 8.3.27.2342).
	// Там вызов и так не из фонового задания, так что отсутствие метода
	// означает то же, что Неопределено.
	Попытка
		Текущее = ФоновыеЗадания.ПолучитьТекущее();
	Исключение
		Текущее = Неопределено;
	КонецПопытки;
	Отбор = Новый Структура("ИмяМетода, Состояние",
		Метаданные.РегламентныеЗадания.гб_ВыгрузкаКаталогаВБот.ИмяМетода,
		СостояниеФоновогоЗадания.Активно);

	Для Каждого Задание Из ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор) Цикл
		Если Текущее = Неопределено ИЛИ Задание.УникальныйИдентификатор <> Текущее.УникальныйИдентификатор Тогда
			ВызватьИсключение "Выгрузка каталога уже выполняется регламентным заданием (запущено "
				+ Формат(Задание.Начало, "ДЛФ=DT") + "), повторный запуск отклонён.";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// «ut-<ггггММдд-ЧЧммсс по UTC>-<8 знаков GUID>», не длиннее 64 символов.
Функция НовыйИдентификаторПрогона()

	Возврат "ut-" + Формат(ТекущаяУниверсальнаяДата(), "ДФ=yyyyMMdd-HHmmss")
		+ "-" + Лев(Строка(Новый УникальныйИдентификатор), 8);

КонецФункции

Функция ИменаВидовЦен(Настройки)

	Имена = Новый Массив;
	Для Каждого ВидЦен Из Настройки.ВидыЦен Цикл
		Имена.Добавить(ВидЦен.Наименование);
	КонецЦикла;

	Возврат СтрСоединить(Имена, ", ");

КонецФункции

Функция ОписаниеОтбора(Настройки)

	Если ЗначениеЗаполнено(Настройки.Сегмент) Тогда
		Возврат "сегмент «" + Настройки.СегментНаименование + "»";
	КонецЕсли;

	Возврат "вся номенклатура";

КонецФункции

#КонецОбласти

#Область Настройки

// Адрес и токен — только для HTTP-режима. Отдельно от настроек выборки,
// чтобы файловый режим работал на базе, где бот ещё не настроен.
Функция НастройкиСвязи()

	Адрес = СокрЛП(Константы.гб_АдресБота.Получить());
	Если ПустаяСтрока(Адрес) Тогда
		ВызватьИсключение "Не заполнена константа «Голди-бот: адрес приёмника каталога».";
	КонецЕсли;
	Если Не СтрНачинаетсяС(НРег(Адрес), "http://") И Не СтрНачинаетсяС(НРег(Адрес), "https://") Тогда
		ВызватьИсключение "Адрес приёмника каталога должен начинаться с http:// или https://, указано: " + Адрес;
	КонецЕсли;

	Токен = СокрЛП(Константы.гб_ТокенБота.Получить());
	Если ПустаяСтрока(Токен) Тогда
		ВызватьИсключение "Не заполнена константа «Голди-бот: токен».";
	КонецЕсли;

	Возврат Новый Структура("Адрес, Токен", Адрес, Токен);

КонецФункции

Функция НастройкиВыборки()

	Настройки = Новый Структура;
	Настройки.Вставить("ВидыЦен", НайтиВидыЦен(Константы.гб_ВидыЦенБота.Получить()));

	Склад = НайтиСклад(Константы.гб_СкладБота.Получить());
	Настройки.Вставить("Склад", Склад);
	Настройки.Вставить("СкладНаименование", СтрокаЗначение(Склад.Наименование));
	Настройки.Вставить("СкладИдентификатор", ГУИД(Склад));

	Сегмент = НайтиСегмент(Константы.гб_СегментНоменклатурыБота.Получить());
	Настройки.Вставить("Сегмент", Сегмент);
	Настройки.Вставить("СегментНаименование", СтрокаЗначение(Сегмент));

	Возврат Настройки;

КонецФункции

// Имена из константы — через запятую, точку с запятой или с новой строки.
// Каждое имя обязано найтись среди элементов справочника по точному
// совпадению после СокрЛП, и ровно один раз: ненайденные перечисляются в
// одном исключении, чтобы константу чинили за один заход, а не по имени за
// прогон, а имя с несколькими элементами — отдельным исключением, потому что
// чинить его надо в справочнике (см. ТекстНеоднозначности).
//
// Возвращаемое значение:
//  Массив - структуры Ссылка, Наименование, Идентификатор (GUID), Валюта
//           (ISO-код), в порядке константы, без повторов.
//
Функция НайтиВидыЦен(Знач Текст)

	Имена = Новый Массив;
	Для Каждого Часть Из СтрРазделить(СтрокаЗначение(Текст), "," + ";" + Символы.ПС + Символы.ВК, Ложь) Цикл
		Имя = СокрЛП(Часть);
		Если Не ПустаяСтрока(Имя) И Имена.Найти(Имя) = Неопределено Тогда
			Имена.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Если Имена.Количество() = 0 Тогда
		ВызватьИсключение "Не заполнена константа «Голди-бот: виды цен»: нужен хотя бы один вид цен.";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВидыЦен.Ссылка КАК Ссылка,
	|	ВидыЦен.Наименование КАК Наименование,
	|	ВидыЦен.ВалютаЦены.Код КАК КодВалюты
	|ИЗ
	|	Справочник.ВидыЦен КАК ВидыЦен
	|ГДЕ
	|	НЕ ВидыЦен.ЭтоГруппа
	|	И НЕ ВидыЦен.ПометкаУдаления";

	// Имя после СокрЛП → все элементы с таким именем. Наименование в структуре
	// остаётся как в базе, с концевыми пробелами: оно нужно только для текста
	// исключения о неоднозначном имени.
	ПоИмени = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Наименование = СтрокаЗначение(Выборка.Наименование);
		Совпадения = ПоИмени[Наименование];
		Если Совпадения = Неопределено Тогда
			Совпадения = Новый Массив;
			ПоИмени.Вставить(Наименование, Совпадения);
		КонецЕсли;
		Совпадения.Добавить(Новый Структура("Ссылка, Наименование, КодВалюты",
			Выборка.Ссылка, Выборка.Наименование, Выборка.КодВалюты));
	КонецЦикла;

	Найденные = Новый Массив;
	НеНайденные = Новый Массив;
	Неоднозначные = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		Совпадения = ПоИмени[Имя];
		Если Совпадения = Неопределено Тогда
			НеНайденные.Добавить(Имя);
			Продолжить;
		КонецЕсли;
		Если Совпадения.Количество() > 1 Тогда
			Неоднозначные.Добавить(ТекстНеоднозначности("Виды цен", Имя, Совпадения));
			Продолжить;
		КонецЕсли;

		ВидЦен = Новый Структура;
		ВидЦен.Вставить("Ссылка", Совпадения[0].Ссылка);
		ВидЦен.Вставить("Наименование", Имя);
		ВидЦен.Вставить("Идентификатор", ГУИД(Совпадения[0].Ссылка));
		ВидЦен.Вставить("Валюта", КодВалютыISO(Совпадения[0].КодВалюты));
		Найденные.Добавить(ВидЦен);
	КонецЦикла;

	Если НеНайденные.Количество() > 0 Тогда
		ВызватьИсключение "В справочнике «Виды цен» не найдены (сравнение по точному имени): "
			+ СтрСоединить(НеНайденные, ", ") + ". Проверьте константу «Голди-бот: виды цен».";
	КонецЕсли;
	Если Неоднозначные.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(Неоднозначные, Символы.ПС);
	КонецЕсли;

	Для Каждого ВидЦен Из Найденные Цикл
		Если ПустаяСтрока(ВидЦен.Валюта) Тогда
			ВызватьИсключение "У вида цен «" + ВидЦен.Наименование + "» не указана валюта: бот не примет цены без валюты.";
		КонецЕсли;
	КонецЦикла;

	Возврат Найденные;

КонецФункции

// ISO 4217 по коду валюты справочника; для незнакомого кода — сам числовой
// код (три знака), чтобы бот увидел незнакомую валюту и отложил такие цены
// как неподдерживаемые, а не показал чужие рубли. Наименование валюты для
// этого не годится: в справочнике оно до 10 символов, а колонка валюты у
// бота — 8, и пачка видов цен падала бы с ошибкой длины вместо отказа по
// валюте.
Функция КодВалютыISO(Знач Код)

	Код = СтрокаЗначение(Код);
	Если Код = "643" Тогда
		Возврат "RUB";
	ИначеЕсли Код = "840" Тогда
		Возврат "USD";
	ИначеЕсли Код = "978" Тогда
		Возврат "EUR";
	КонецЕсли;

	Возврат Код;

КонецФункции

// Склад по наименованию после СокрЛП среди элементов (не групп): в базе есть
// склад с пробелом на конце имени, и сравнивать в коде надёжнее, чем в
// запросе. Совпадение должно быть ровно одно (см. ТекстНеоднозначности).
Функция НайтиСклад(Знач Текст)

	Имя = СтрокаЗначение(Текст);
	Если ПустаяСтрока(Имя) Тогда
		ВызватьИсключение "Не заполнена константа «Голди-бот: склад остатков».";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Склады.Ссылка КАК Ссылка,
	|	Склады.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Склады КАК Склады
	|ГДЕ
	|	НЕ Склады.ЭтоГруппа
	|	И НЕ Склады.ПометкаУдаления";

	Совпадения = СовпаденияПоИмени(Запрос.Выполнить().Выбрать(), Имя);
	Если Совпадения.Количество() = 0 Тогда
		ВызватьИсключение "Склад «" + Имя + "» не найден среди элементов справочника «Склады». Проверьте константу «Голди-бот: склад остатков».";
	КонецЕсли;
	Если Совпадения.Количество() > 1 Тогда
		ВызватьИсключение ТекстНеоднозначности("Склады", Имя, Совпадения);
	КонецЕсли;

	Возврат Совпадения[0].Ссылка;

КонецФункции

// Пустая константа — без отбора: возвращается пустая ссылка. Непустая —
// как у склада: ровно один элемент с таким именем после СокрЛП.
Функция НайтиСегмент(Знач Текст)

	Имя = СтрокаЗначение(Текст);
	Если ПустаяСтрока(Имя) Тогда
		Возврат Справочники.СегментыНоменклатуры.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сегменты.Ссылка КАК Ссылка,
	|	Сегменты.Наименование КАК Наименование
	|ИЗ
	|	Справочник.СегментыНоменклатуры КАК Сегменты
	|ГДЕ
	|	НЕ Сегменты.ЭтоГруппа
	|	И НЕ Сегменты.ПометкаУдаления";

	Совпадения = СовпаденияПоИмени(Запрос.Выполнить().Выбрать(), Имя);
	Если Совпадения.Количество() = 0 Тогда
		ВызватьИсключение "Сегмент «" + Имя + "» не найден среди элементов справочника «Сегменты номенклатуры». Проверьте константу «Голди-бот: сегмент номенклатуры».";
	КонецЕсли;
	Если Совпадения.Количество() > 1 Тогда
		ВызватьИсключение ТекстНеоднозначности("Сегменты номенклатуры", Имя, Совпадения);
	КонецЕсли;

	Возврат Совпадения[0].Ссылка;

КонецФункции

// Строки выборки с полями Ссылка и Наименование, у которых наименование
// после СокрЛП равно Имя.
//
// Возвращаемое значение:
//  Массив - структуры Ссылка, Наименование (как в базе, с концевыми пробелами).
//
Функция СовпаденияПоИмени(Выборка, Знач Имя)

	Совпадения = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если СтрокаЗначение(Выборка.Наименование) = Имя Тогда
			Совпадения.Добавить(Новый Структура("Ссылка, Наименование", Выборка.Ссылка, Выборка.Наименование));
		КонецЕсли;
	КонецЦикла;

	Возврат Совпадения;

КонецФункции

// Текст исключения о нескольких элементах с одним именем. Взять первый
// попавшийся нельзя: у справочников УТ уникальность наименования не
// проверяется, запросы идут без УПОРЯДОЧИТЬ, и от прогона к прогону в бота
// уходил бы то один GUID, то другой — а финализация подметала бы «другой».
// Наименования — в кавычках, чтобы были видны концевые пробелы, и с GUID,
// чтобы элементы можно было различить в справочнике.
Функция ТекстНеоднозначности(Знач Справочник, Знач Имя, Совпадения)

	Части = Новый Массив;
	Для Каждого Совпадение Из Совпадения Цикл
		Части.Добавить("«" + Совпадение.Наименование + "» (" + ГУИД(Совпадение.Ссылка) + ")");
	КонецЦикла;

	Возврат "В справочнике «" + Справочник + "» несколько элементов с именем «" + Имя + "»: "
		+ СтрСоединить(Части, ", ") + ". Переименуйте лишние или пометьте их на удаление.";

КонецФункции

#КонецОбласти

#Область ОтборНоменклатуры

// Одна временная таблица ВТ_Номенклатура на прогон: по ней идут и товары, и
// категории, и отборы в срезе цен и в остатках, так что «выгружаемый товар»
// везде означает одно и то же.
//
// Описание в таблицу не кладётся: это строка неограниченной длины, а такие
// поля во временных таблицах и в соединениях ведут себя с ограничениями. Его
// подтягивает запрос товаров соединением по ссылке.
//
// Возвращаемое значение:
//  Число - сколько товаров осталось после отбора.
//
Функция ПодготовитьНоменклатуру(Прогон)

	ОтбиратьПоСегменту = ЗначениеЗаполнено(Прогон.Настройки.Сегмент);

	ОтборПоСегменту = "";
	Если ОтбиратьПоСегменту Тогда
		ОтборПоСегменту =
		"	И Номенклатура.Ссылка В
		|		(ВЫБРАТЬ
		|			Сегменты.Номенклатура
		|		ИЗ
		|			РегистрСведений.НоменклатураСегмента КАК Сегменты
		|		ГДЕ
		|			Сегменты.Сегмент = &Сегмент)";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Прогон.МенеджерВТ;
	Запрос.УстановитьПараметр("Сегмент", Прогон.Настройки.Сегмент);
	Запрос.Текст = СтрЗаменить(
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.Код КАК Код,
	|	Номенклатура.Артикул КАК Артикул,
	|	Номенклатура.Наименование КАК Наименование,
	|	Номенклатура.НаименованиеПолное КАК НаименованиеПолное,
	|	Номенклатура.Родитель КАК Родитель,
	|	Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Номенклатура.ЕдиницаИзмерения.Наименование КАК ЕдиницаНаименование
	|ПОМЕСТИТЬ ВТ_Номенклатура
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ЭтоГруппа
	|	И НЕ Номенклатура.ПометкаУдаления
	|	И Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	|&ОтборПоСегменту
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка", "&ОтборПоСегменту", ОтборПоСегменту);
	Запрос.Выполнить();

	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК ЧислоТоваров
	|ИЗ
	|	ВТ_Номенклатура КАК ВТ";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	ЧислоТоваров = Выборка.ЧислоТоваров;

	Если ЧислоТоваров = 0 Тогда
		ВызватьИсключение "После отбора (" + ОписаниеОтбора(Прогон.Настройки) + ") не осталось ни одного товара."
			+ " Выгрузка остановлена до отправки: пустой каталог деактивировал бы в боте все товары.";
	КонецЕсли;

	Возврат ЧислоТоваров;

КонецФункции

#КонецОбласти

#Область Области

// Категории — только группы, являющиеся предком хотя бы одного выгружаемого
// товара: замыкание по Родитель считается в коде по словарю «группа → родитель».
// Пометка удаления группы не учитывается намеренно: товар уходит со своим
// category_id, и если бы группа с пометкой не выгружалась, бот получил бы
// ссылку на раздел, которого у него нет или который он погасил, — товар не
// показывался бы ни в одном разделе витрины, без единой ошибки. Живой товар
// тянет за собой всех предков; группа без живых товаров в пачку и так не
// попадает.
Процедура ВыгрузитьКатегории(Прогон)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Группы.Ссылка КАК Ссылка,
	|	Группы.Родитель КАК Родитель,
	|	Группы.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Номенклатура КАК Группы
	|ГДЕ
	|	Группы.ЭтоГруппа
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка";

	Группы = Новый Соответствие;
	Порядок = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Группы.Вставить(Выборка.Ссылка, Новый Структура("Родитель, Наименование", Выборка.Родитель, Выборка.Наименование));
		Порядок.Добавить(Выборка.Ссылка);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Прогон.МенеджерВТ;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ.Родитель КАК Родитель
	|ИЗ
	|	ВТ_Номенклатура КАК ВТ";

	Нужные = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Текущая = Выборка.Родитель;
		Пока ЗначениеЗаполнено(Текущая) Цикл
			Группа = Группы[Текущая];
			Если Группа = Неопределено ИЛИ Нужные[Текущая] <> Неопределено Тогда
				Прервать;
			КонецЕсли;
			Нужные.Вставить(Текущая, Истина);
			Текущая = Группа.Родитель;
		КонецЦикла;
	КонецЦикла;

	Накопитель = НовыйНакопитель("categories", НоваяОбласть("categories"), БезРазбиенияНаПачки(), "categories");
	Для Каждого Ссылка Из Порядок Цикл
		Если Нужные[Ссылка] = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Группа = Группы[Ссылка];

		Элемент = Новый Структура;
		Элемент.Вставить("id", ГУИД(Ссылка));
		Элемент.Вставить("parent_id", ГУИДИлиNull(Группа.Родитель));
		Элемент.Вставить("name", СтрокаЗначение(Группа.Наименование));
		Элемент.Вставить("source_changed_at", Неопределено);
		ДобавитьСтроку(Прогон, Накопитель, Элемент);
	КонецЦикла;

	ЗавершитьОбласть(Прогон, Накопитель);

КонецПроцедуры

// Товары пачками по РазмерПачкиТоваров в порядке ссылки — стабильное
// разбиение от прогона к прогону.
Процедура ВыгрузитьТовары(Прогон)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Прогон.МенеджерВТ;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВТ.Ссылка КАК Ссылка,
	|	ВТ.Код КАК Код,
	|	ВТ.Артикул КАК Артикул,
	|	ВТ.Наименование КАК Наименование,
	|	ВТ.НаименованиеПолное КАК НаименованиеПолное,
	|	ВТ.Родитель КАК Родитель,
	|	ВТ.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВТ.ЕдиницаНаименование КАК ЕдиницаНаименование,
	|	Номенклатура.Описание КАК Описание
	|ИЗ
	|	ВТ_Номенклатура КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО Номенклатура.Ссылка = ВТ.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ.Ссылка";

	Накопитель = НовыйНакопитель("products", НоваяОбласть("products"), РазмерПачкиТоваров(), "products");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Артикул = СтрокаЗначение(Выборка.Артикул);
		Код = СтрокаЗначение(Выборка.Код);
		Наименование = СтрокаЗначение(Выборка.Наименование);
		НаименованиеПолное = СтрокаЗначение(Выборка.НаименованиеПолное);
		Единица = СтрокаЗначение(Выборка.ЕдиницаНаименование);

		Элемент = Новый Структура;
		Элемент.Вставить("id", ГУИД(Выборка.Ссылка));
		Элемент.Вставить("sku", ?(ПустаяСтрока(Артикул), Код, Артикул));
		Элемент.Вставить("name", Наименование);
		Элемент.Вставить("full_name",
			?(ПустаяСтрока(НаименованиеПолное) ИЛИ НаименованиеПолное = Наименование, Неопределено, НаименованиеПолное));
		Элемент.Вставить("category_id", ГУИДИлиNull(Выборка.Родитель));
		Элемент.Вставить("unit_id", ГУИДИлиNull(Выборка.ЕдиницаИзмерения));
		Элемент.Вставить("unit_name", ?(ПустаяСтрока(Единица), "шт", Единица));
		Элемент.Вставить("unit_ratio", 1);
		Элемент.Вставить("description", СтрокаИлиNull(Выборка.Описание));
		Элемент.Вставить("image_url", Неопределено);
		Элемент.Вставить("source_changed_at", Неопределено);
		ДобавитьСтроку(Прогон, Накопитель, Элемент);
	КонецЦикла;

	ЗавершитьОбласть(Прогон, Накопитель);

КонецПроцедуры

// Только виды цен из константы: закупочные и прочие внутренние виды наружу
// не уходят даже как справочник.
Процедура ВыгрузитьВидыЦен(Прогон)

	Накопитель = НовыйНакопитель("price_types", НоваяОбласть("price_types"), БезРазбиенияНаПачки(), "price_types");
	Для Каждого ВидЦен Из Прогон.Настройки.ВидыЦен Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("id", ВидЦен.Идентификатор);
		Элемент.Вставить("name", ВидЦен.Наименование);
		Элемент.Вставить("currency", ВидЦен.Валюта);
		Элемент.Вставить("source_changed_at", Неопределено);
		ДобавитьСтроку(Прогон, Накопитель, Элемент);
	КонецЦикла;

	ЗавершитьОбласть(Прогон, Накопитель);

КонецПроцедуры

// Цены — по каждому виду отдельная область со своей финализацией: подметание
// у бота идёт в границах price_type_id, иначе один вид стёр бы все остальные.
//
// Упаковка в регистре — ресурс, а не измерение, поэтому строка с упаковкой —
// это последняя цена товара по этому виду, и отдельной строки «за штуку» у
// него нет. У бота одна цена на товар, и такие строки пропускаются со счётом.
// source_changed_at — период среза, то есть дата установки цены: по ней бот
// решает, новее ли присланная цена той, что у него есть.
Процедура ВыгрузитьЦены(Прогон)

	Для Каждого ВидЦен Из Прогон.Настройки.ВидыЦен Цикл
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Прогон.МенеджерВТ;
		Запрос.УстановитьПараметр("ВидЦены", ВидЦен.Ссылка);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Цены.Номенклатура КАК Номенклатура,
		|	Цены.Цена КАК Цена,
		|	Цены.Упаковка КАК Упаковка,
		|	Цены.Период КАК Период
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|			,
		|			ВидЦены = &ВидЦены
		|				И Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
		|				И Номенклатура В
		|					(ВЫБРАТЬ
		|						ВТ.Ссылка
		|					ИЗ
		|						ВТ_Номенклатура КАК ВТ)) КАК Цены
		|ГДЕ
		|	Цены.Цена > 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	Цены.Номенклатура";

		Область = НоваяОбласть("prices");
		Область.Вставить("price_type_id", ВидЦен.Идентификатор);
		Накопитель = НовыйНакопитель("prices", Область, РазмерПачкиДвижений(), "prices [" + ВидЦен.Наименование + "]");

		СУпаковкой = 0;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.Упаковка) Тогда
				СУпаковкой = СУпаковкой + 1;
				Продолжить;
			КонецЕсли;

			Элемент = Новый Структура;
			Элемент.Вставить("product_id", ГУИД(Выборка.Номенклатура));
			Элемент.Вставить("price_type_id", ВидЦен.Идентификатор);
			Элемент.Вставить("amount", Выборка.Цена);
			Элемент.Вставить("currency", ВидЦен.Валюта);
			Элемент.Вставить("source_changed_at", ДатаISO(Выборка.Период));
			ДобавитьСтроку(Прогон, Накопитель, Элемент);
		КонецЦикла;

		Если СУпаковкой > 0 Тогда
			Накопитель.Заметки.Добавить("пропущено строк с упаковкой " + Формат(СУпаковкой, "ЧН=0; ЧГ=0"));
		КонецЕсли;

		ЗавершитьОбласть(Прогон, Накопитель);
	КонецЦикла;

КонецПроцедуры

// Свободный остаток одного склада: в наличии минус к отгрузке, только
// положительный. Остатки складываются по товару поверх остальных измерений
// регистра (помещение, серия) — боту нужна одна цифра на склад. Обособленный
// остаток (измерение Назначение заполнено) не считается свободным и
// отсекается условием виртуальной таблицы: это товар, лежащий на складе под
// конкретный заказ или сделку, и продать его другому покупателю нельзя.
// Права на справочник Назначения для этого не нужны — литерал ЗНАЧЕНИЕ
// таблицу не читает.
//
// Финализация уходит без warehouse_id, и это не оплошность. Бот складывает
// остатки по всем складам, которые у него есть, а прогон выгружает ровно один
// склад — значит, всё остальное в его таблице остатков должно исчезнуть, в том
// числе остатки склада, который раньше стоял в константе. Подметание в границах
// склада оставило бы их навсегда, и витрина прибавляла бы к остатку склад,
// которого больше нет в выгрузке. batch_id один на прогон, поэтому глобальное
// подметание трогает только чужие прогоны.
Процедура ВыгрузитьОстатки(Прогон)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Прогон.МенеджерВТ;
	Запрос.УстановитьПараметр("Склад", Прогон.Настройки.Склад);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	СУММА(Остатки.ВНаличииОстаток) - СУММА(Остатки.КОтгрузкеОстаток) КАК Свободно
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(
	|			,
	|			Склад = &Склад
	|				И Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|				И Номенклатура В
	|					(ВЫБРАТЬ
	|						ВТ.Ссылка
	|					ИЗ
	|						ВТ_Номенклатура КАК ВТ)) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Номенклатура
	|
	|ИМЕЮЩИЕ
	|	СУММА(Остатки.ВНаличииОстаток) - СУММА(Остатки.КОтгрузкеОстаток) > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Остатки.Номенклатура";

	Область = НоваяОбласть("stock");
	Область.Вставить("warehouse_id", Прогон.Настройки.СкладИдентификатор);
	Накопитель = НовыйНакопитель("stock", Область, РазмерПачкиДвижений(), "stock [" + Прогон.Настройки.СкладНаименование + "]");
	Накопитель.ОбластьФинализации = НоваяОбласть("stock");

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("product_id", ГУИД(Выборка.Номенклатура));
		Элемент.Вставить("warehouse_id", Прогон.Настройки.СкладИдентификатор);
		Элемент.Вставить("quantity", Выборка.Свободно);
		Элемент.Вставить("source_changed_at", Неопределено);
		ДобавитьСтроку(Прогон, Накопитель, Элемент);
	КонецЦикла;

	ЗавершитьОбласть(Прогон, Накопитель);

КонецПроцедуры

// Привязка вида цен к телефону покупателя. Источник — индивидуальные
// действующие соглашения с клиентами: реквизит ВидЦен у партнёров в этой базе
// пуст у всех. «Действующее» — не только статус: срок действия соглашения
// в УТ проверяется датами, а статус при его истечении сам не меняется,
// поэтому просроченное соглашение (или ещё не начавшееся) отсекается по
// ДатаНачалаДействия и ДатаОкончанияДействия, где пустая дата означает
// «не ограничено». Партнёр с пометкой удаления отсекается тоже: его
// соглашение формально живо, а сам он в базе — нет. Телефоны — из контактной
// информации партнёра, поле Представление: в нём бывает несколько номеров
// через запятую и текст, а поля НомерТелефона / НомерТелефонаБезКодов
// заполнены ненадёжно.
//
// Один телефон — одна привязка. Повтор с тем же видом цен считается
// повтором, с другим — конфликтом; в обоих случаях побеждает первая
// встретившаяся. Порядок обхода фиксирован: партнёр, дата соглашения по
// убыванию, номер строки контакта.
Процедура ВыгрузитьПривязкиВидовЦен(Прогон)

	ВидыЦен = Новый Массив;
	ИдентификаторыВидов = Новый Соответствие;
	Для Каждого ВидЦен Из Прогон.Настройки.ВидыЦен Цикл
		ВидыЦен.Добавить(ВидЦен.Ссылка);
		ИдентификаторыВидов.Вставить(ВидЦен.Ссылка, ВидЦен.Идентификатор);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидыЦен", ВидыЦен);
	Запрос.УстановитьПараметр("Сегодня", НачалоДня(ТекущаяДатаСеанса()));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Соглашения.Партнер КАК Партнер,
	|	Соглашения.ВидЦен КАК ВидЦен,
	|	Контакты.Представление КАК Представление
	|ИЗ
	|	Справочник.СоглашенияСКлиентами КАК Соглашения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Партнеры.КонтактнаяИнформация КАК Контакты
	|		ПО Контакты.Ссылка = Соглашения.Партнер
	|			И Контакты.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|ГДЕ
	|	НЕ Соглашения.Типовое
	|	И Соглашения.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыСоглашенийСКлиентами.Действует)
	|	И НЕ Соглашения.ПометкаУдаления
	|	И НЕ Соглашения.Партнер.ПометкаУдаления
	|	И (Соглашения.ДатаНачалаДействия = ДАТАВРЕМЯ(1, 1, 1)
	|		ИЛИ Соглашения.ДатаНачалаДействия <= &Сегодня)
	|	И (Соглашения.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|		ИЛИ Соглашения.ДатаОкончанияДействия >= &Сегодня)
	|	И Соглашения.ВидЦен В (&ВидыЦен)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Соглашения.Партнер,
	|	Соглашения.Дата УБЫВ,
	|	Контакты.НомерСтроки";

	Накопитель = НовыйНакопитель("price_type_bindings", НоваяОбласть("bindings"), БезРазбиенияНаПачки(), "price_type_bindings");

	Телефоны = Новый Соответствие;
	Партнеры = Новый Соответствие;
	Конфликтов = 0;
	Повторов = 0;
	БезТелефона = 0;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ИдентификаторВида = ИдентификаторыВидов[Выборка.ВидЦен];
		Если ИдентификаторВида = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Номера = НомераТелефонов(Выборка.Представление);
		Если Номера.Количество() = 0 Тогда
			БезТелефона = БезТелефона + 1;
			Продолжить;
		КонецЕсли;

		Для Каждого Номер Из Номера Цикл
			Существующий = Телефоны[Номер];
			Если Существующий <> Неопределено Тогда
				Если Существующий = ИдентификаторВида Тогда
					Повторов = Повторов + 1;
				Иначе
					Конфликтов = Конфликтов + 1;
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Телефоны.Вставить(Номер, ИдентификаторВида);
			Партнеры.Вставить(Выборка.Партнер, Истина);

			Элемент = Новый Структура;
			Элемент.Вставить("phone_number", Номер);
			Элемент.Вставить("price_type_id", ИдентификаторВида);
			Элемент.Вставить("source_counterparty_id", ГУИД(Выборка.Партнер));
			Элемент.Вставить("source_changed_at", Неопределено);
			ДобавитьСтроку(Прогон, Накопитель, Элемент);
		КонецЦикла;
	КонецЦикла;

	Накопитель.Заметки.Добавить("партнёров " + Формат(Партнеры.Количество(), "ЧН=0; ЧГ=0"));
	Накопитель.Заметки.Добавить("конфликтов телефонов " + Формат(Конфликтов, "ЧН=0; ЧГ=0"));
	Накопитель.Заметки.Добавить("повторов " + Формат(Повторов, "ЧН=0; ЧГ=0"));
	Накопитель.Заметки.Добавить("контактов без распознанного номера " + Формат(БезТелефона, "ЧН=0; ЧГ=0"));

	ЗавершитьОбласть(Прогон, Накопитель);

КонецПроцедуры

// Телефоны из представления контакта: разбить по «,» и «;», в каждой части
// собрать куски цифр между буквами, каждый кусок отдельно привести к E.164
// для России. Буква — разделитель, а не конец части: имя перед номером
// («Иван +7 918 …») номер не прячет, а «доб. 123» после номера остаётся
// отдельным куском и отсеивается по длине, не приклеиваясь к нему.
//
// Возвращаемое значение:
//  Массив - строки «+7XXXXXXXXXX», без повторов; пустой, если ничего не разобралось.
//
Функция НомераТелефонов(Знач Представление)

	Номера = Новый Массив;
	Для Каждого Часть Из СтрРазделить(СтрокаЗначение(Представление), ",;", Ложь) Цикл
		Для Каждого Кусок Из КускиЦифрМеждуБуквами(Часть) Цикл
			Номер = НомерE164(Кусок);
			Если Номер <> Неопределено И Номера.Найти(Номер) = Неопределено Тогда
				Номера.Добавить(Номер);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Номера;

КонецФункции

// Цифры текста, собранные в куски: буква (символ, у которого есть регистр)
// закрывает текущий кусок; скобки, дефисы, пробелы и плюс пропускаются и
// кусок не рвут. «Татьяна бух 8-918-584-27-97» → один кусок «89185842797»,
// «8-918-584-27-97 доб 123» → «89185842797» и «123».
//
// Возвращаемое значение:
//  Массив - непустые строки из цифр в порядке появления.
//
Функция КускиЦифрМеждуБуквами(Знач Текст)

	Куски = Новый Массив;
	Цифры = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Знак = Сред(Текст, Позиция, 1);
		Если СтрНайти("0123456789", Знак) > 0 Тогда
			Цифры = Цифры + Знак;
		ИначеЕсли ВРег(Знак) <> НРег(Знак) И Не ПустаяСтрока(Цифры) Тогда
			Куски.Добавить(Цифры);
			Цифры = "";
		КонецЕсли;
	КонецЦикла;
	Если Не ПустаяСтрока(Цифры) Тогда
		Куски.Добавить(Цифры);
	КонецЕсли;

	Возврат Куски;

КонецФункции

// 11 цифр с ведущей 7 или 8 → +7 и последние десять; 10 цифр с ведущей 9 →
// +7 и все десять; остальное — не телефон.
Функция НомерE164(Знач Цифры)

	Если СтрДлина(Цифры) = 11 И (Лев(Цифры, 1) = "7" ИЛИ Лев(Цифры, 1) = "8") Тогда
		Возврат "+7" + Прав(Цифры, 10);
	ИначеЕсли СтрДлина(Цифры) = 10 И Лев(Цифры, 1) = "9" Тогда
		Возврат "+7" + Цифры;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область Накопитель

// Накопитель строк одной области: собирает пачку до РазмерПачки, отправляет
// её и копит счётчики для отчёта. Прогон передаётся отдельно, а не хранится
// в накопителе, чтобы структуры не ссылались друг на друга по кругу.
Функция НовыйНакопитель(Знач ИмяКоллекции, Область, Знач РазмерПачки, Знач Заголовок)

	Накопитель = Новый Структура;
	Накопитель.Вставить("ИмяКоллекции", ИмяКоллекции);
	Накопитель.Вставить("Область", Область);
	// Чем финализировать: по умолчанию той же областью, что у пачек; остатки
	// подменяют её областью без склада (см. ВыгрузитьОстатки).
	Накопитель.Вставить("ОбластьФинализации", Область);
	Накопитель.Вставить("РазмерПачки", РазмерПачки);
	Накопитель.Вставить("Заголовок", Заголовок);
	Накопитель.Вставить("Строки", Новый Массив);
	Накопитель.Вставить("Пачек", 0);
	Накопитель.Вставить("ВсегоСтрок", 0);
	Накопитель.Вставить("Принято", 0);
	Накопитель.Вставить("Отклонено", 0);
	Накопитель.Вставить("Подметено", 0);
	Накопитель.Вставить("Заметки", Новый Массив);

	Возврат Накопитель;

КонецФункции

Функция НоваяОбласть(Знач Вид)

	Возврат Новый Структура("kind", Вид);

КонецФункции

Процедура ДобавитьСтроку(Прогон, Накопитель, Элемент)

	Накопитель.Строки.Добавить(Элемент);
	Если Накопитель.РазмерПачки > 0 И Накопитель.Строки.Количество() >= Накопитель.РазмерПачки Тогда
		ОтправитьНакопленное(Прогон, Накопитель);
	КонецЕсли;

КонецПроцедуры

Процедура ОтправитьНакопленное(Прогон, Накопитель)

	Если Накопитель.Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Накопитель.Пачек = Накопитель.Пачек + 1;

	Пачка = Новый Структура;
	Пачка.Вставить("batch_id", Прогон.Идентификатор);
	Пачка.Вставить("scope", Накопитель.Область);
	Пачка.Вставить(Накопитель.ИмяКоллекции, Накопитель.Строки);

	Результат = ОтправитьПачку(Прогон.Отправитель, Пачка, Накопитель);
	Накопитель.Принято = Накопитель.Принято + Результат.Принято;
	Накопитель.Отклонено = Накопитель.Отклонено + Результат.Отклонено;
	Накопитель.ВсегоСтрок = Накопитель.ВсегоСтрок + Накопитель.Строки.Количество();
	Накопитель.Строки = Новый Массив;

КонецПроцедуры

// Остаток пачки, финализация, строка отчёта. Пустая область финализируется
// тоже: это и есть сообщение «в 1С по этой области ничего не осталось».
Процедура ЗавершитьОбласть(Прогон, Накопитель)

	ОтправитьНакопленное(Прогон, Накопитель);
	Накопитель.Подметено = Финализировать(Прогон.Отправитель, Прогон.Идентификатор, Накопитель);

	Текст = Накопитель.Заголовок
		+ ": пачек " + Формат(Накопитель.Пачек, "ЧН=0; ЧГ=0")
		+ ", строк " + Формат(Накопитель.ВсегоСтрок, "ЧН=0; ЧГ=0");
	Если Прогон.Отправитель.Режим = "HTTP" Тогда
		Текст = Текст
			+ ", accepted " + Формат(Накопитель.Принято, "ЧН=0; ЧГ=0")
			+ ", discarded " + Формат(Накопитель.Отклонено, "ЧН=0; ЧГ=0")
			+ ", swept " + Формат(Накопитель.Подметено, "ЧН=0; ЧГ=0");
	Иначе
		Текст = Текст + ", записано в файлы";
	КонецЕсли;
	Для Каждого Заметка Из Накопитель.Заметки Цикл
		Текст = Текст + ", " + Заметка;
	КонецЦикла;

	Прогон.Отчет.Добавить(Текст);

КонецПроцедуры

#КонецОбласти

#Область Отправитель

// Отправитель — структура с полем Режим: «HTTP» держит одно соединение на весь
// прогон, базовый путь и заголовки; «Файлы» — папку и сквозной номер файла.
// Сбор пачек про режим не знает, различие живёт только здесь.

Функция НовыйОтправительHTTP(Связь)

	Адрес = РазобратьАдрес(Связь.Адрес);

	Отправитель = Новый Структура;
	Отправитель.Вставить("Режим", "HTTP");
	Отправитель.Вставить("Описание", "HTTP " + Связь.Адрес);
	Отправитель.Вставить("Соединение", НовоеСоединение(Адрес));
	Отправитель.Вставить("БазовыйПуть", Адрес.Путь);
	Отправитель.Вставить("Заголовки", ЗаголовкиЗапроса(Связь.Токен));

	Возврат Отправитель;

КонецФункции

Функция НовыйОтправительФайлы(Знач Каталог)

	Каталог = СтрокаЗначение(Каталог);
	Пока СтрЗаканчиваетсяНа(Каталог, "\") ИЛИ СтрЗаканчиваетсяНа(Каталог, "/") Цикл
		Каталог = Лев(Каталог, СтрДлина(Каталог) - 1);
	КонецЦикла;
	Если ПустаяСтрока(Каталог) Тогда
		ВызватьИсключение "Не указана папка для файлов выгрузки.";
	КонецЕсли;

	Файл = Новый Файл(Каталог);
	Если Файл.Существует() Тогда
		Если Не Файл.ЭтоКаталог() Тогда
			ВызватьИсключение "Путь «" + Каталог + "» занят файлом, а нужна папка.";
		КонецЕсли;
	Иначе
		СоздатьКаталог(Каталог);
	КонецЕсли;

	Отправитель = Новый Структура;
	Отправитель.Вставить("Режим", "Файлы");
	Отправитель.Вставить("Описание", "файлы в " + Каталог);
	Отправитель.Вставить("Каталог", Каталог);
	Отправитель.Вставить("НомерФайла", 0);

	Возврат Отправитель;

КонецФункции

// Возвращаемое значение:
//  Структура - Принято, Отклонено (accepted, discarded из ответа бота; в
//              файловом режиме нули).
//
Функция ОтправитьПачку(Отправитель, Пачка, Накопитель)

	Описание = "область " + Накопитель.Область.kind + ", пачка " + Формат(Накопитель.Пачек, "ЧН=0; ЧГ=0");

	Если Отправитель.Режим = "Файлы" Тогда
		ЗаписатьJSONВФайл(Отправитель, Накопитель.Область.kind + КвалификаторОбласти(Накопитель.Область), Пачка);
		Возврат Новый Структура("Принято, Отклонено", 0, 0);
	КонецЕсли;

	Ответ = ВыполнитьPOST(Отправитель, "/catalog/batches", Пачка, Описание);

	Возврат Новый Структура("Принято, Отклонено",
		ЧислоИзОтвета(Ответ, "accepted", Описание),
		ЧислоИзОтвета(Ответ, "discarded", Описание));

КонецФункции

// Возвращаемое значение:
//  Число - swept из ответа бота; в файловом режиме ноль.
//
Функция Финализировать(Отправитель, Знач Идентификатор, Накопитель)

	Описание = "область " + Накопитель.Область.kind + ", финализация";
	Тело = Новый Структура("scope", Накопитель.ОбластьФинализации);

	Если Отправитель.Режим = "Файлы" Тогда
		ЗаписатьJSONВФайл(Отправитель, "finalize-" + Накопитель.Область.kind, Тело);
		Возврат 0;
	КонецЕсли;

	Ответ = ВыполнитьPOST(Отправитель, "/catalog/batches/" + Идентификатор + "/finalize", Тело, Описание);

	Возврат ЧислоИзОтвета(Ответ, "swept", Описание);

КонецФункции

// Хвост имени файла: GUID вида цен или склада, чтобы пачки разных видов цен
// не слились в одно имя.
Функция КвалификаторОбласти(Область)

	Значение = Неопределено;
	Если Область.Свойство("price_type_id", Значение) Тогда
		Возврат "-" + Значение;
	КонецЕсли;
	Если Область.Свойство("warehouse_id", Значение) Тогда
		Возврат "-" + Значение;
	КонецЕсли;

	Возврат "";

КонецФункции

#КонецОбласти

#Область HTTP

// Разбор адреса приёмника на схему, хост, порт и базовый путь без
// завершающего «/». Порт по умолчанию — 80 или 443 по схеме.
Функция РазобратьАдрес(Знач Адрес)

	Адрес = СтрокаЗначение(Адрес);
	ПозицияСхемы = СтрНайти(Адрес, "://");
	Если ПозицияСхемы = 0 Тогда
		ВызватьИсключение "Адрес приёмника каталога без схемы: " + Адрес;
	КонецЕсли;

	Схема = НРег(Лев(Адрес, ПозицияСхемы - 1));
	Если Схема <> "http" И Схема <> "https" Тогда
		ВызватьИсключение "Адрес приёмника каталога: поддерживаются только http и https, указано: " + Адрес;
	КонецЕсли;

	Остаток = Сред(Адрес, ПозицияСхемы + 3);
	ПозицияПути = СтрНайти(Остаток, "/");
	Если ПозицияПути = 0 Тогда
		ХостПорт = Остаток;
		Путь = "";
	Иначе
		ХостПорт = Лев(Остаток, ПозицияПути - 1);
		Путь = Сред(Остаток, ПозицияПути);
	КонецЕсли;
	Пока СтрЗаканчиваетсяНа(Путь, "/") Цикл
		Путь = Лев(Путь, СтрДлина(Путь) - 1);
	КонецЦикла;

	ПозицияПорта = СтрНайти(ХостПорт, ":");
	Если ПозицияПорта = 0 Тогда
		Хост = ХостПорт;
		Порт = ?(Схема = "https", 443, 80);
	Иначе
		Хост = Лев(ХостПорт, ПозицияПорта - 1);
		Попытка
			Порт = Число(Сред(ХостПорт, ПозицияПорта + 1));
		Исключение
			Порт = 0;
		КонецПопытки;
		Если Порт <= 0 ИЛИ Порт > 65535 ИЛИ Порт <> Цел(Порт) Тогда
			ВызватьИсключение "Адрес приёмника каталога: порт должен быть целым числом от 1 до 65535, указано: " + Адрес;
		КонецЕсли;
	КонецЕсли;
	Если ПустаяСтрока(Хост) Тогда
		ВызватьИсключение "Адрес приёмника каталога без хоста: " + Адрес;
	КонецЕсли;

	Возврат Новый Структура("Схема, Хост, Порт, Путь", Схема, Хост, Порт, Путь);

КонецФункции

// Одно соединение на прогон: несколько десятков запросов подряд по одному
// TCP-соединению вместо рукопожатия на каждую пачку.
Функция НовоеСоединение(Адрес)

	// Не через ?(): тернарный оператор в 1С вычисляет обе ветки, и объект
	// защищённого соединения создавался бы и для http.
	Защита = Неопределено;
	Если Адрес.Схема = "https" Тогда
		Защита = Новый ЗащищенноеСоединениеOpenSSL;
	КонецЕсли;

	Возврат Новый HTTPСоединение(Адрес.Хост, Адрес.Порт, , , Неопределено, ТаймаутСоединения(), Защита);

КонецФункции

Функция ЗаголовкиЗапроса(Знач Токен)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Заголовки.Вставить("Accept", "application/json");

	Возврат Заголовки;

КонецФункции

// POST с JSON-телом; успех — только 2xx с JSON-объектом в ответе. Всё
// остальное — исключение с описанием места (область, пачка), кодом и первыми
// 500 символами тела: по ним видно, ответил ли вообще приёмник или прокси.
//
// Возвращаемое значение:
//  Соответствие - разобранное тело ответа.
//
Функция ВыполнитьPOST(Отправитель, Знач Путь, Тело, Знач Описание)

	Запрос = Новый HTTPЗапрос(Отправитель.БазовыйПуть + Путь, Отправитель.Заголовки);
	Запрос.УстановитьТелоИзСтроки(ВJSON(Тело), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Попытка
		Ответ = Отправитель.Соединение.ОтправитьДляОбработки(Запрос);
	Исключение
		ВызватьИсключение "Голди-бот, " + Описание + ": запрос не выполнен. "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
	Если Ответ.КодСостояния < 200 ИЛИ Ответ.КодСостояния > 299 Тогда
		ВызватьИсключение "Голди-бот, " + Описание + ": HTTP " + Формат(Ответ.КодСостояния, "ЧН=0; ЧГ=0")
			+ ". " + Лев(ТелоОтвета, 500);
	КонецЕсли;

	Возврат РазобратьОтветJSON(ТелоОтвета, Описание);

КонецФункции

Функция РазобратьОтветJSON(Знач Тело, Знач Описание)

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Тело);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		ВызватьИсключение "Голди-бот, " + Описание + ": ответ не разбирается как JSON. " + Лев(Тело, 500);
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		ВызватьИсключение "Голди-бот, " + Описание + ": ответ не JSON-объект. " + Лев(Тело, 500);
	КонецЕсли;

	Возврат Данные;

КонецФункции

// Ответ без числового поля — не наш приёмник (например, прокси ответил 200
// своей страницей), и считать это успехом нельзя.
Функция ЧислоИзОтвета(Данные, Знач Ключ, Знач Описание)

	Значение = Данные.Получить(Ключ);
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		ВызватьИсключение "Голди-бот, " + Описание + ": в ответе нет числового поля " + Ключ + ".";
	КонецЕсли;

	Возврат Значение;

КонецФункции

#КонецОбласти

#Область JSON

// Параметры общие для строки и файла, чтобы файл диагностики был тем же
// байт в байт, что уходит в бота. Третий параметр конструктора —
// ИспользоватьДвойныеКавычки — не трогаем: его умолчание Истина, а Ложь
// даст строки в одинарных кавычках, то есть не JSON.
Функция ПараметрыJSON()

	Возврат Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, "");

КонецФункции

// Структура → JSON. Неопределено уходит как null, числа — числами; даты в
// пачках уже строки, поэтому настройки сериализации дат не нужны.
Функция ВJSON(Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(ПараметрыJSON());
	ЗаписатьJSON(Запись, Значение);

	Возврат Запись.Закрыть();

КонецФункции

// Файл <NNN>-<Основа>.json без BOM: с BOM его не примет ни json.loads, ни
// приёмник, если файл отправить руками. Третий параметр ОткрытьФайл у
// ЗаписьJSON — булево «писать BOM», а не значение ИспользованиеByteOrderMark,
// как у ЗаписьXML: с перечислением платформа отвечает «Несоответствие типов
// (параметр номер 3)» (проверено на 8.3.27.2342).
Процедура ЗаписатьJSONВФайл(Отправитель, Знач Основа, Значение)

	Отправитель.НомерФайла = Отправитель.НомерФайла + 1;
	Номер = Прав("000" + Формат(Отправитель.НомерФайла, "ЧН=0; ЧГ=0"), 3);
	ИмяФайла = Отправитель.Каталог + ПолучитьРазделительПути() + Номер + "-" + Основа + ".json";

	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(ИмяФайла, КодировкаТекста.UTF8, Ложь, ПараметрыJSON());
	ЗаписатьJSON(Запись, Значение);
	Запись.Закрыть();

КонецПроцедуры

#КонецОбласти

#Область Преобразования

// GUID ссылки в том виде, в каком его знает бот: 36 символов в нижнем регистре.
Функция ГУИД(Знач Ссылка)

	Возврат Строка(Ссылка.УникальныйИдентификатор());

КонецФункции

Функция ГУИДИлиNull(Знач Ссылка)

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ГУИД(Ссылка);

КонецФункции

// Дата регистра — в UTC ISO 8601 с суффиксом Z: «2026-09-13T07:00:05Z».
// XMLСтрока даёт ISO-представление даты без зависимости от локали и
// форматных строк; УниверсальноеВремя переводит из часового пояса сеанса.
Функция ДатаISO(Знач Момент)

	Возврат XMLСтрока(УниверсальноеВремя(Момент)) + "Z";

КонецФункции

// Строка после СокрЛП; Неопределено и NULL из запроса — пустая строка.
Функция СтрокаЗначение(Знач Значение)

	Если Значение = Неопределено ИЛИ ТипЗнч(Значение) = Тип("Null") Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Строка(Значение));

КонецФункции

// Строка или Неопределено (→ null): бот отличает «нет описания» от пустого.
Функция СтрокаИлиNull(Знач Значение)

	Текст = СтрокаЗначение(Значение);
	Если ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Текст;

КонецФункции

#КонецОбласти

#КонецОбласти
