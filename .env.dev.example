# Local development, ready to copy:  cp .env.dev.example .env
#
# Points at docker-compose.dev.yml, whose host ports are offset because 5432 and
# 5433 on this machine belong to PostgreSQL for 1C.
#
#   docker compose -f docker-compose.dev.yml up -d
#   uv run --frozen alembic upgrade head
#
# .env itself is not committed — .gitignore excludes it.

# Token of the DEVELOPMENT bot from BotFather — not the one real customers
# write to. Registration links accounts by phone number, so a test order placed
# through the production bot reaches real people.
#
# The worker and the scheduler need it too, and refuse to start without it:
# notifications go out as the same bot the customer already talks to, and the
# scheduler builds the worker's broker. One variable rather than two copies of
# one secret.
TELEGRAM_BOT_TOKEN=

TELEGRAM_DEFAULT_LOCALE=ru
TELEGRAM_USE_REDIS_STORAGE=true
TELEGRAM_USE_REDIS_EVENT_ISOLATION=true

# Your own number, so the first /start hands you the ADMIN role.
#GOLDY_ADMIN_PHONE_NUMBERS=+79991234567

# Must match a price type id the catalog import brought in; the example
# snapshot under docs/design/ carries this one.
GOLDY_DEFAULT_PRICE_TYPE_ID=pt-retail

# Catalog receiver — the process a local 1C (or a curl from docs/manual-check.md)
# posts catalog batches to. Only `just receiver` reads these. The token is a
# throwaway that satisfies the 32-character minimum; put the same string into
# the extension's constant гб_ТокенБота when pointing a local УТ at the bot,
# and give it http://127.0.0.1:8090 as the address rather than "localhost",
# which Windows may resolve to ::1 where an IPv4 bind does not answer. Loopback
# is enough because that 1C runs on the same machine; a bind to all interfaces
# would expose a catalog-rewriting endpoint to the whole network for nothing.
GOLDY_CATALOG_RECEIVER_TOKEN=dev-catalog-token-change-me-0123456789
GOLDY_CATALOG_RECEIVER_HOST=127.0.0.1
GOLDY_CATALOG_RECEIVER_PORT=8090
GOLDY_CATALOG_RECEIVER_MAX_BODY_MIB=64

POSTGRES_USER=goldy
POSTGRES_PASSWORD=goldy
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=goldy
POSTGRES_DRIVER=asyncpg

DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=30
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=5
DB_ECHO=false

REDIS_HOST=localhost
REDIS_PORT=6380

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
