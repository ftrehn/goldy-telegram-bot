# Приёмник каталога goldy-бота: в него 1С пушит товары и цены.
#
# Это единственный входящий сервис бота. Остальной трафик к Telegram —
# исходящий, и Caddy его не касается: бот забирает апдейты по long polling,
# воркер шлёт уведомления через sendMessage, и оба ходят к api.telegram.org
# тем маршрутом, который задаёт TELEGRAM_PROXY_URL. Планировщик Telegram не
# вызывает вовсе — он только ставит задачи в очередь воркера. Файл
# импортируется общим Caddy из /opt/edge/sites/*.caddy; домен берётся из
# GOLDY_RECEIVER_DOMAIN в /opt/edge/.env. Приёмник виден в сети edge под именем
# goldy-receiver — его объявляет docker-compose.prod.yml бота, и это же имя
# записано в reverse_proxy ниже.

{$GOLDY_RECEIVER_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	# Access-лог в stderr контейнера: без него не видно, дошла ли пачка от 1С
	# и с каким кодом ушёл ответ
	log

	# Наружу смотрят только два пути: GET /catalog/ping и POST /catalog/batches
	# с хвостом. Всё остальное отбивается здесь, не доходя до приёмника, —
	# сканерам и опечаткам в гб_АдресБота незачем видеть его 401.
	@catalog path /catalog/*
	handle @catalog {
		# Приёмник сам режет тело на GOLDY_CATALOG_RECEIVER_MAX_BODY_MIB
		# (по умолчанию 64 MiB) и отвечает своим 413. Лимит здесь чуть выше,
		# чтобы Caddy не ответил 413 раньше приёмника и 1С получила ошибку от
		# того, кто её и объяснит. Штатная пачка на порядки меньше.
		request_body {
			max_size 70MB
		}
		reverse_proxy goldy-receiver:8090 {
			# Пачка в две тысячи цен пишется одной транзакцией, и ответ
			# уходит только после коммита — до двух минут. 1С ждёт именно
			# его, чтобы решить, слать ли следующую, поэтому таймаут ответа
			# с запасом; по умолчанию у Caddy его нет вовсе.
			transport http {
				response_header_timeout 180s
			}
		}
	}
	handle {
		respond 404
	}
}
